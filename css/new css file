
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #f3f0ff;
    color: #292344;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #ffffff;
    box-shadow: 0 5px 20px rgba(80, 60, 140, 0.08);
}

.logo {
    font-size: 26px;
    font-weight: 800;
}

.logo span {
    color: #8065e8;
}

nav {
    display: flex;
    gap: 28px;
}

nav a {
    text-decoration: none;
    color: #514b68;
    font-size: 14px;
    font-weight: 500;
}

nav a:hover {
    color: #8065e8;
}

.nav-btn, .primary-btn {
    background: #8065e8;
    color: white;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 14px;
    box-shadow: 0 6px 12px rgba(128, 101, 232, 0.25);
}

/* Hero */
.hero {
    min-height: 570px;
    padding: 80px 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    background: linear-gradient(135deg, #eeeaff, #e1e9ff);
}

.hero-content {
    max-width: 580px;
}

.tag {
    color: #8065e8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 48px;
    line-height: 1.2;
    margin: 20px 0;
}

.hero h1 span {
    color: #8065e8;
}

.hero-content p {
    color: #716b85;
    line-height: 1.8;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.secondary-btn {
    text-decoration: none;
    color: #8065e8;
    padding: 12px 22px;
    border: 2px solid #8065e8;
    border-radius: 14px;
}

/* Clay Card */
.hero-card {
    width: 330px;
    padding: 30px;
    text-align: center;
    background: #f8f6ff;
    border-radius: 30px;
    box-shadow: 12px 12px 25px #d0cbea,
                -12px -12px 25px #ffffff;
}

.card-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.hero-card h2 {
    font-size: 21px;
    margin-bottom: 8px;
}

.hero-card p {
    color: #817a99;
    font-size: 13px;
    margin-bottom: 20px;
}

.mini-card {
    background: #eeeaff;
    padding: 13px;
    border-radius: 15px;
    margin-top: 12px;
    font-size: 13px;
    box-shadow: inset 3px 3px 7px #d8d2ed,
                inset -3px -3px 7px #ffffff;
}

/* Features */
.features {
    padding: 70px 10%;
    text-align: center;
}

.features h2 {
    font-size: 30px;
}

.section-subtitle {
    color: #817a99;
    margin: 12px 0 35px;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature-card {
    padding: 30px 22px;
    background: #f7f5ff;
    border-radius: 25px;
    box-shadow: 8px 8px 18px #d9d5eb,
                -8px -8px 18px #ffffff;
}

.feature-icon {
    font-size: 38px;
    margin-bottom: 15px;
}

.feature-card h3 {
    margin-bottom: 12px;
}

.feature-card p {
    color: #817a99;
    font-size: 13px;
    line-height: 1.7;
}

/* Footer */
footer {
    text-align: center;
    padding: 25px;
    color: #817a99;
    font-size: 13px;
}

/* Mobile */
@media (max-width: 768px) {
    .navbar {
        flex-direction: column;
        gap: 18px;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        padding: 55px 7%;
    }

    .hero h1 {
        font-size: 34px;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-card {
        width: 100%;
        max-width: 330px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }
}
